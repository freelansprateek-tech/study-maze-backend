# Copy to .env and adjust. Every value shown is the default unless noted.

# --- API ---------------------------------------------------------------------
# Origins allowed to call the API (comma-separated). Use the URL the frontend is
# served from, e.g. https://chipsense.example.com. "*" allows any origin.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Generator LLM -----------------------------------------------------------
# auto   -> OpenAI-compatible API if LLM_API_KEY is set, otherwise the local model
# local  -> Hugging Face model on this machine (shared with the classifier)
# openai -> https://api.openai.com/v1            (needs LLM_API_KEY)
# groq   -> https://api.groq.com/openai/v1       (needs LLM_API_KEY)
# ollama -> http://localhost:11434/v1            (no key)
LLM_PROVIDER=auto
LLM_API_KEY=
# Leave empty to use the provider's preset (openai: gpt-4o-mini,
# groq: llama-3.3-70b-versatile, ollama: qwen2.5:1.5b, local: CLASSIFIER_MODEL).
LLM_MODEL=
# Override for any other OpenAI-compatible endpoint (LM Studio, vLLM, OpenRouter...).
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
ANSWER_MAX_TOKENS=800
# true = longer answer in simple words plus an explanation; false = short exact answer
DETAILED_ANSWERS=true
SUMMARY_MAX_TOKENS=180

# --- Attention classifier ------------------------------------------------------
CLASSIFIER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
CLASSIFIER_LAYERS=4
CLASSIFIER_MAX_CHUNK_TOKENS=256
# auto -> mps, then cuda, then cpu
DEVICE=auto
# auto -> bfloat16 on mps, float16 on cuda, float32 on cpu (also: float16, bfloat16, float32)
MODEL_DTYPE=auto
# true -> load the models at startup instead of on the first question
PRELOAD_MODELS=false

# --- Knowledge base and retrieval ---------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=8
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=30

# --- Rearranging module ---------------------------------------------------------
# Noise documents added to the indirect-assist branch on every query.
REARRANGE_NOISE_DOCS=2
# pool -> built-in distractor pool; llm -> generated by the LLM
NOISE_SOURCE=pool
RANDOM_SEED=42
